HOST=127.0.0.1
PORT=3015
DATABASE_PATH=./data/openmetrika.db
# Set to 1 behind an HTTPS reverse proxy.
COOKIE_SECURE=0
# Allowed public origin for dashboard mutations; leave blank for same-origin.
PUBLIC_ORIGIN=http://localhost:3015
RETENTION_DAYS=180
REPLAY_RETENTION_DAYS=30

# Optional amoCRM OAuth; see docs/AMOCRM.md. Keep secrets on the server only.
AMO_CLIENT_ID=
AMO_CLIENT_SECRET=
AMO_REDIRECT_URI=https://analytics.example.com/api/amocrm/callback
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Back up this key securely together with the database; do not regenerate on restart.
AMO_TOKEN_ENCRYPTION_KEY=
