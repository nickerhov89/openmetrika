{
  "name": "openmetrika",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "node scripts/build-tracker.mjs && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "demo": "node scripts/demo.mjs",
    "test": "node --test tests/*.test.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "release:pack": "node scripts/package.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rrweb": "2.2.0",
    "rrweb-player": "2.2.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5"
  }
}
